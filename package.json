{
  "name": "anon-vote-monorepo",
  "version": "1.0.0",
  "description": "AnonVote - Unified Turborepo monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/crypto",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "node init && turbo run dev --parallel",
    "dev:backend": "node init && turbo run dev --filter=backend",
    "dev:frontend": "node init && turbo run dev --filter=frontend",
    "build": "node init && turbo run build",
    "build:backend": "node init && turbo run build --filter=backend",
    "build:frontend": "node init && turbo run build --filter=frontend",
    "test": "turbo run test",
    "test:backend": "turbo run test --filter=backend",
    "test:frontend": "turbo run test --filter=frontend",
    "lint": "turbo run lint",
    "build:contracts": "node init && cargo build --target wasm32v1-none --release --locked"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
